rules_version = '2';
// Firestore is retired: the app's data lives in Cloudflare D1 (see cloudflare/). Nothing may read or write here.
// (Firebase is still used for sign-in and hosting only.)
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
