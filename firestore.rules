rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Requires that this Firebase Auth account has a matching profile doc
    // created by an admin (via Admin > Users). Firebase Auth accounts can be
    // created directly against the public Identity Toolkit REST API using
    // nothing but the project's public apiKey (which every Firebase web app
    // ships in its JS bundle by design) — that doesn't go through this app's
    // UI or its `users/{uid}` bookkeeping at all. Without this check, any
    // such self-registered account would satisfy plain isSignedIn() and get
    // full read/write on every collection below. get() on a missing doc
    // fails closed (denies) when `.data` is accessed, so this is safe by
    // default even before the profile is created.
    function isProvisioned() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Looks up the requester's own profile to check role. Costs one extra
    // read against the Firestore free/security-rules quota per request,
    // which is negligible at this app's scale.
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Admins, or anyone explicitly granted "Edit" on the HR module (Admin >
    // Users / HR > Employees "App Login Access" section). Lets HR managers
    // approve leaves/expenses/advances and run payroll without needing the
    // admin role, while still keeping plain employees from writing directly
    // to records the UI only shows them as read-only or self-service-create.
    // Mirrors src/auth/permissions.js's hasPermission() resolution order —
    // moduleRights.HR first, falling back to the legacy departments[] array
    // for logins created before per-module rights existed — so the client
    // UI (gated the same way) and this rule never disagree about who can write.
    function hasHRWriteAccess() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAdmin() ||
        ('moduleRights' in profile && profile.moduleRights.HR == 'edit') ||
        (!('moduleRights' in profile) && 'departments' in profile && 'HR' in profile.departments);
    }

    // User profiles — all provisioned users can read (needed for form dropdowns,
    // team assignment, name lookup). Only admins can create/update/delete.
    match /users/{userId} {
      allow read: if isProvisioned();
      allow create, update, delete: if isAdmin();
    }

    // Organisation roles (Admin > Roles tab) — any provisioned user can read
    // them (needed to show role names), only admins can create/edit/delete.
    match /roles/{roleId} {
      allow read: if isProvisioned();
      allow write: if isAdmin();
    }

    // Organisation departments (Admin > Departments tab) — same shape as
    // roles: any provisioned user can read them (needed for the Employees
    // "Department" dropdown), only admins can create/edit/delete.
    match /departments/{deptId} {
      allow read: if isProvisioned();
      allow write: if isAdmin();
    }

    // General Tasks module — all provisioned users can read and write their
    // own tasks; admins/managers can read everything (enforced in the app layer).
    match /tasks/{taskId} {
      allow read, write: if isProvisioned();
    }

    // Services / Inventory module — open to any provisioned user for now.
    // Tighten to role-based checks later if specific collections need it.
    match /inventory_items/{id}                    { allow read, write: if isProvisioned(); }
    match /inventory_warehouses/{id}                { allow read, write: if isProvisioned(); }
    match /inventory_stocks/{id}                     { allow read, write: if isProvisioned(); }
    match /inventory_consumption_requests/{id}       { allow read, write: if isProvisioned(); }
    match /inventory_spare_requests/{id}             { allow read, write: if isProvisioned(); }
    match /inventory_stock_adjustments/{id}          { allow read, write: if isProvisioned(); }
    match /inventory_stock_transfers/{id}            { allow read, write: if isProvisioned(); }
    match /inventory_reorder_consolidations/{id}     { allow read, write: if isProvisioned(); }

    // CRM module — customers, product catalog, orders, and the sales
    // pipeline (deals). Open to any provisioned user for now, same pattern
    // as the inventory collections.
    match /crm_customers/{id}                        { allow read, write: if isProvisioned(); }
    match /crm_contacts/{id}                          { allow read, write: if isProvisioned(); }
    match /crm_products/{id}                         { allow read, write: if isProvisioned(); }
    match /crm_orders/{id}                            { allow read, write: if isProvisioned(); }
    match /crm_deals/{id}                             { allow read, write: if isProvisioned(); }
    match /crm_sites/{id}                             { allow read, write: if isProvisioned(); }
    match /crm_targets/{id}                           { allow read: if isProvisioned(); allow write: if isAdmin(); }
    match /crm_tasks/{id}                             { allow read, write: if isProvisioned(); }
    match /team_member_requests/{id} {
      allow read, create: if isProvisioned();
      allow update, delete: if isAdmin();
    }

    // HR module — employees, attendance, leaves, salary slips, advances, expense claims.
    // hr_employees/hr_attendance/hr_salary_slips are HR-generated records (not
    // self-service) — full write requires HR/admin access. hr_leaves/hr_advances/
    // hr_expenses are self-service requests: anyone provisioned can create their
    // own, but only HR/admin can approve/reject/modify an existing one.
    match /hr_employees/{id}         { allow read: if isProvisioned(); allow write: if hasHRWriteAccess(); }
    match /hr_attendance/{id}        { allow read: if isProvisioned(); allow write: if hasHRWriteAccess(); }
    match /hr_leaves/{id} {
      allow read: if isProvisioned();
      allow create: if isProvisioned();
      allow update, delete: if hasHRWriteAccess();
    }
    match /hr_salary_slips/{id}      { allow read: if isProvisioned(); allow write: if hasHRWriteAccess(); }
    match /hr_salary_revisions/{id}  { allow read: if isProvisioned(); allow write: if isAdmin(); }
    match /hr_advances/{id} {
      allow read: if isProvisioned();
      allow create: if isProvisioned();
      allow update, delete: if hasHRWriteAccess();
    }
    match /hr_expenses/{id} {
      allow read: if isProvisioned();
      allow create: if isProvisioned();
      allow update, delete: if hasHRWriteAccess();
    }

    // Holiday calendar (HR > Holidays) — admin-managed reference list, same
    // posture as roles/departments: everyone reads, only HR/admin writes.
    match /hr_holidays/{id}          { allow read: if isProvisioned(); allow write: if hasHRWriteAccess(); }

    // Asset management (HR > Assets) — company equipment issued to staff.
    match /hr_assets/{id}            { allow read: if isProvisioned(); allow write: if hasHRWriteAccess(); }

    // Policies & Announcements (HR > Announcements) — everyone reads, only HR/admin publishes.
    match /hr_announcements/{id}     { allow read: if isProvisioned(); allow write: if hasHRWriteAccess(); }

    // Candidate CV repository (HR > Candidate CVs) — external candidate PII
    // (name/mobile/email/résumé text), not employee data, so unlike the
    // employee directory this is HR/admin-only for both read and write.
    match /hr_candidates/{id}        { allow read, write: if hasHRWriteAccess(); }

    // Projects module — tasks, service logs, project register (won CRM deals), cost line items.
    match /project_tasks/{id}         { allow read, write: if isProvisioned(); }
    match /project_service_logs/{id}  { allow read, write: if isProvisioned(); }
    match /projects/{id}              { allow read, write: if isProvisioned(); }
    match /project_costs/{id}         { allow read, write: if isProvisioned(); }
    // Project Execution Plan (WBS / Gantt tasks) — all provisioned users can read;
    // write restricted to project managers, sales managers, and admins.
    match /project_plan_tasks/{id} {
      allow read: if isProvisioned();
      allow write: if isProvisioned() && (
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'project_manager' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'sales_manager'
      );
    }

    // Public task links — no-login external resource access.
    // Anyone can read (token-based security via unguessable URL).
    // Only provisioned users can create. External users can only update status fields.
    match /public_task_links/{token} {
      allow read: if true;
      allow create: if isProvisioned();
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'statusNote', 'updatedAt']);
    }

    // Finance module — expenses, payments received, payables (vendor bills), vendors, HSN master, invoices, company settings.
    match /finance_expenses/{id}     { allow read, write: if isProvisioned(); }
    match /finance_payments/{id}     { allow read, write: if isProvisioned(); }
    match /finance_payables/{id}     { allow read, write: if isProvisioned(); }
    match /finance_vendors/{id}      { allow read, write: if isProvisioned(); }
    match /finance_hsn_codes/{id}    { allow read, write: if isProvisioned(); }
    match /finance_invoices/{id}     { allow read, write: if isProvisioned(); }
    match /company_settings/{id}     { allow read: if isProvisioned(); allow write: if isAdmin(); }

    // General Ledger — Chart of Accounts (admin-managed reference data shared
    // across both companies; individual transactions/journal lines carry a
    // `company` field for per-entity reporting, same pattern as finance_invoices)
    // and manual Journal Entries for adjustments/corrections/opening balances
    // that have no natural source document. Invoices/payments/expenses/payables
    // are NOT auto-posted here — they're derived into virtual GL lines at
    // read-time by finance/utils/ledger.js and never separately persisted.
    match /finance_accounts/{id}         { allow read: if isProvisioned(); allow write: if isAdmin(); }
    match /finance_journal_entries/{id}  { allow read: if isProvisioned(); allow write: if isAdmin(); }

    // Banking — bank/cash account master data (name, account number, IFSC,
    // opening balance). Not individually mapped in the GL yet; same
    // read/write pattern as finance_vendors/finance_hsn_codes.
    match /finance_bank_accounts/{id}    { allow read, write: if isProvisioned(); }

    // Anything not explicitly listed above is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
